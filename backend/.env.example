# ============================================================
# FloweApp - Local / Docker Environment Configuration Example
# Copy this file to .env and configure your secrets.
# ============================================================

# ---------- General ----------
ASPNETCORE_ENVIRONMENT=Development

# ---------- Identity Service ----------
IDENTITY_HTTP_PORT=5192
IDENTITY_HTTPS_PORT=7056
IDENTITY_IMAGE_TAG=latest

# ---------- Catalog Service ----------
CATALOG_HTTP_PORT=5193
CATALOG_IMAGE_TAG=latest

# ---------- AddressCart Service ----------
ADDRESSCART_HTTP_PORT=5194
ADDRESSCART_IMAGE_TAG=latest
CatalogService__BaseUrl=http://localhost:5193

# ---------- Orders Service ----------
ORDERS_HTTP_PORT=5195
ORDERS_IMAGE_TAG=latest

# ---------- Payment Service ----------
PAYMENT_HTTP_PORT=5196
PAYMENT_HTTPS_PORT=7058
PAYMENT_IMAGE_TAG=latest

# ---------- Stripe Configuration ----------
Stripe__SecretKey=sk_test_placeholder
Stripe__WebhookSecret=whsec_placeholder
Stripe__SuccessUrl=http://localhost:5173/orders
Stripe__CancelUrl=http://localhost:5173/cart

# ---------- API Gateway ----------
GATEWAY_HTTP_PORT=5000
GATEWAY_IMAGE_TAG=latest

Gateway__IdentityServiceUrl=http://localhost:5192
Gateway__CatalogServiceUrl=http://localhost:5193
Gateway__AddressCartServiceUrl=http://localhost:5194
Gateway__OrdersServiceUrl=http://localhost:5195
Gateway__PaymentServiceUrl=http://localhost:5196

# Browser origins allowed through CORS
Gateway__AllowedOrigins=http://localhost:3000,http://localhost:5173,http://localhost:4200

# Rate limits
Gateway__RateLimiting__Auth__PermitLimit=10
Gateway__RateLimiting__Auth__WindowSeconds=60
Gateway__RateLimiting__Default__PermitLimit=100
Gateway__RateLimiting__Default__WindowSeconds=60

Gateway__HealthCheck__IntervalSeconds=10
Gateway__HealthCheck__TimeoutSeconds=5

# ---------- SQL Server ----------
SQL_SERVER=sqlserver
AUTH_DATABASE_NAME=FloweAppAuthDb
CATALOG_DATABASE_NAME=FloweAppCatalogDb
ADDRESSCART_DATABASE_NAME=FloweAppAddressCartDb
ORDERS_DATABASE_NAME=FloweAppOrdersDb
PAYMENT_DATABASE_NAME=FloweAppPaymentDb

SQL_USER=sa
MSSQL_SA_PASSWORD=YourStrong@Password123
MSSQL_PORT=1433
MSSQL_PID=Developer

ConnectionStrings__AuthDatabase=Server=localhost,1433;Database=FloweAppAuthDb;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=True;
ConnectionStrings__CatalogDatabase=Server=localhost,1433;Database=FloweAppCatalogDb;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=True;
ConnectionStrings__AddressCartDatabase=Server=localhost,1433;Database=FloweAppAddressCartDb;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=True;
ConnectionStrings__OrdersDatabase=Server=localhost,1433;Database=FloweAppOrdersDb;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=True;
ConnectionStrings__PaymentDatabase=Server=localhost,1433;Database=FloweAppPaymentDb;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=True;

# ---------- RabbitMQ ----------
RabbitMq__Username=flowerapp
RabbitMq__Password=YourRabbitMqPassword!
RabbitMq__Port=5672
RabbitMq__Host=localhost

# ---------- Redis ----------
REDIS_PORT=6379
Redis__ConnectionString=localhost:6379

# ---------- OTP & Security ----------
Otp__PepperSecret=generate_a_random_32_byte_hex_string_here

# ---------- Geocoding Configuration ----------
Geocoding__ApiKey=YOUR_GOOGLE_MAPS_API_KEY
Geocoding__BaseUrl=https://maps.googleapis.com/maps/api/geocode/json
Geocoding__UseMockProvider=true

# ---------- Firebase ----------
Firebase__CredentialsPath=./secrets/firebase-service-account.json

# ---------- JWT ----------
Jwt__SecretKey=generate_a_super_secret_jwt_key_at_least_32_characters_long
Jwt__Issuer=FlowersApp.IdentityService
Jwt__Audience=FlowersApp.Clients
Jwt__AccessTokenExpiryMinutes=15
Jwt__RefreshTokenExpiryDays=30

# ---------- Email (SMTP) ----------
Email__SmtpHost=smtp.example.com
Email__SmtpPort=587
Email__SenderEmail=no-reply@floweapp.com
Email__SenderName=Flowery
Email__Username=your-smtp-user
Email__Password=your-smtp-password
Email__EnableSsl=true

# ---------- Admin Seed ----------
AdminSeed__Email=admin@floweapp.com
AdminSeed__Password=Admin@Pass123!
AdminSeed__FirstName=System
AdminSeed__LastName=Admin
AdminSeed__PhoneNumber=01000000000
